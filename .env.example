# MongoDB Connection URI (Format Atlas / Local)
# Ganti dengan connection string MongoDB Atlas Anda
MONGODB_URI=mongodb://username:password@cluster.mongodb.net:27017/geraibumdes?ssl=true&authSource=admin

# JWT Secret Key untuk enkripsi sesi login (minimal 32 karakter acak)
JWT_SECRET=super_secret_key_for_geraibumdes_development_2026_secure

# Base URL Aplikasi (default port dev: 3041)
NEXT_PUBLIC_APP_URL=http://localhost:3041

# Environment mode
NODE_ENV=development
PORT=3041

MINIO_ENDPOINT=https://minio-console.stimiyapmim.ac.id
MINIO_ACCESS_KEY=admin_pusdatin
MINIO_SECRET_KEY=admin_pusdatin123
MINIO_BUCKET=gerai-bumdes